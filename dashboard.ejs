<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div style="text-align:center; padding:50px;">
    <h1>Welcome, <%= user.username %>!</h1>
    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}` : '/default-avatar.png' %>" 
         alt="Avatar" style="width:100px; height:100px; border-radius:50%;">
    <p>User ID: <%= user.id %></p>
    <a href="/auth/logout" style="background:#5865F2;color:white;padding:12px 24px;text-decoration:none;border-radius:5px;display:inline-block;margin-top:20px;">Logout</a>
  </div>
</body>
</html>
